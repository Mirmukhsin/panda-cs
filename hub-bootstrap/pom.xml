<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cs2hub</groupId>
        <artifactId>cs2-superhub</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>hub-bootstrap</artifactId>
    <name>hub-bootstrap</name>
    <description>Main application bootstrap, runtime orchestration, and configuration</description>

    <dependencies>
        <!-- Internal Modules -->
        <dependency>
            <groupId>com.cs2hub</groupId>
            <artifactId>hub-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs2hub</groupId>
            <artifactId>hub-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs2hub</groupId>
            <artifactId>hub-loadouts</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs2hub</groupId>
            <artifactId>hub-minigames</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs2hub</groupId>
            <artifactId>hub-stratboard</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs2hub</groupId>
            <artifactId>hub-matches</artifactId>
        </dependency>

        <!-- Database Driver & Migrations -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
